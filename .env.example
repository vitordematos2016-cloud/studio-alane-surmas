# Copie para .env e preencha. Valores vazios usam os padrões definidos no código.
# Configuração do site (lida pelo Vite em tempo de build).
# Atenção: variáveis VITE_ vão para o JavaScript público do site.
# Use aqui apenas dados públicos (links de contato). NUNCA coloque senhas ou chaves secretas.
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=
VITE_INSTAGRAM_HANDLE=
VITE_GOOGLE_MAPS_URL=
VITE_GOOGLE_MAPS_EMBED=
VITE_DEVELOPER_URL=
